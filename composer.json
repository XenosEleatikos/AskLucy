{
    "name": "xenos/asklucy",
    "type": "library",
    "description": "AskLucy – A PHP library for creating Lucene search queries",
    "keywords": ["lucene", "search", "query", "query-builder", "solr", "elasticsearch", "php"],
    "homepage": "https://github.com/XenosEleatikos/AskLucy",
    "license": "MIT",
    "authors": [
        {
            "name": "Christoph Hochholzer",
            "email": "christoph@hochholzer.info",
            "homepage": "https://github.com/XenosEleatikos",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/XenosEleatikos/AskLucy/issues",
        "source": "https://github.com/XenosEleatikos/AskLucy"
    },
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.35.8",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "AskLucy\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AskLucy\\Test\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "cs-fix": "php-cs-fixer fix --allow-risky=yes",
        "stan": "phpstan analyse --no-progress",
        "test": "phpunit",
        "infection": "infection --threads=max --show-mutations",
        "ci": [
            "@cs",
            "@stan",
            "@test",
            "@infection"
        ]
    },
    "scripts-descriptions": {
        "cs": "Checks the coding style",
        "cs-fix": "Fixes the coding style",
        "stan": "Runs the static analysis",
        "test": "Runs the unit tests",
        "infection": "Runs the mutation tests",
        "ci": "Runs all checks of the CI pipeline"
    }
}
